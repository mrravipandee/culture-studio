{
  "name": "culture-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "admin:check": "node scripts/check-admin-password.mjs",
    "admin:test-auth": "node --env-file=.env scripts/test-admin-auth.mjs",
    "admin:account": "node --env-file=.env scripts/admin-account.mjs",
    "db:indexes": "node --env-file=.env --experimental-strip-types --import ./scripts/lib/ts-runtime.mjs scripts/db-indexes.mjs",
    "seed:dev-enquiries": "node --env-file=.env scripts/seed-dev-enquiries.mjs",
    "cs:migrate": "node --env-file=.env --experimental-strip-types --import ./scripts/lib/ts-runtime.mjs scripts/migrate-case-studies.mjs",
    "test:case-studies": "node --experimental-strip-types --import ./scripts/lib/ts-runtime.mjs --test tests/case-studies/service.test.mts tests/case-studies/media.test.mts",
    "test:subscribers": "node --experimental-strip-types --import ./scripts/lib/ts-runtime.mjs --test tests/subscribers/subscribers.test.mts",
    "test:subscribers:db": "node --env-file=.env --experimental-strip-types --import ./scripts/lib/ts-runtime.mjs scripts/test-subscribers-db.mjs",
    "test:case-studies:db": "node --env-file=.env --experimental-strip-types --import ./scripts/lib/ts-runtime.mjs scripts/test-case-studies-db.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@node-rs/argon2": "^2.2.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "iron-session": "^9.1.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.69.0",
    "mongodb": "^7.9.0",
    "mongoose": "^9.12.2",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5"
  }
