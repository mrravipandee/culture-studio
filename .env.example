# CULT.URE — environment variables (placeholders only; never commit real values).
# Copy to .env.local for local development. Set the same names in Vercel for deploys.

# ---- Admin portal (server-only; never prefix with NEXT_PUBLIC_) ----
# At least 32 random characters. Generate with:  openssl rand -base64 48
# Changing it signs every admin session out.
SESSION_SECRET=

# BOOTSTRAP ONLY — read by `npm run admin:account -- bootstrap --confirm`, never by the app.
# Used once to create the first admin in MongoDB (collection: admins). After that MongoDB is
# the source of truth; change the password in Admin → Settings, or recover a lost one with
# `npm run admin:account -- reset-password --confirm`. You may remove these afterwards.
ADMIN_EMAIL=admin@example.com
# Argon2id hash of the initial password. Generate with:  npm run admin:hash
# In .env files escape every $ as \$ (the script prints that form for you).
ADMIN_PASSWORD_HASH=

# Optional. Proxy IP headers (X-Forwarded-For) are trusted automatically on Vercel only.
# Set to true ONLY behind another proxy that overwrites them; otherwise IPs aren't recorded.
# TRUST_PROXY_HEADERS=false

# ---- Database (server-only) ----
# MongoDB Atlas connection string, including the database name (e.g. /culture).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/culture?retryWrites=true&w=majority
# Optional. Connections per server instance (1–100, default 10). Keep it small on Vercel.
# MONGODB_MAX_POOL_SIZE=10

# ---- Contact form ----
# No variable needed: the enquiry form posts to /api/enquiries and stores in MongoDB.
# (NEXT_PUBLIC_INQUIRY_ENDPOINT is no longer used.)
